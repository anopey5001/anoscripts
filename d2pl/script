local HttpService = game:GetService("HttpService")

local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"

local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Options = Library.Options
local Toggles = Library.Toggles

Library.ForceCheckbox = false
Library.ShowToggleFrameInKeybinds = true

local URL = "https://d2pl.anonodopro.workers.dev/"

local FolderName = "D2PL"
local KeyFile = FolderName .. "/key.txt"

local function SaveKey(Key)
    if not isfolder(FolderName) then
        makefolder(FolderName)
    end

    writefile(KeyFile, Key)
end

local function GetSavedKey()
    if not isfile(KeyFile) then
        return nil
    end

    local Success, Key = pcall(function()
        return readfile(KeyFile)
    end)

    if not Success or typeof(Key) ~= "string" then
        return nil
    end

    Key = Key:match("^%s*(.-)%s*$")

    if Key == "" then
        return nil
    end

    return Key
end

local function DeleteSavedKey()
    if isfile(KeyFile) then
        delfile(KeyFile)
    end
end

local function FetchScript(Key)
    local Success, Response = pcall(function()
        return HttpService:RequestAsync({
            Url = URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode({
                key = Key
            })
        })
    end)

    if not Success then
        return nil, "Request failed: " .. tostring(Response)
    end

    if Response.StatusCode == 403 then
        return nil, "Key not accepted"
    end

    if not Response.Success then
        return nil, "Server error: " .. tostring(Response.StatusCode)
    end

    return Response.Body
end

local CheckingKey = false

local function LoadKey(Key, FromStartup)
    if CheckingKey then
        return
    end

    if typeof(Key) ~= "string" then
        if not FromStartup then
            Library:Notify({
                Title = "D2PL",
                Description = "Invalid key",
                Time = 4
            })
        end

        return
    end

    Key = Key:match("^%s*(.-)%s*$")

    if Key == "" then
        if not FromStartup then
            Library:Notify({
                Title = "D2PL",
                Description = "Please enter a key",
                Time = 4
            })
        end

        return
    end

    CheckingKey = true

    if FromStartup then
        Library:Notify({
            Title = "D2PL",
            Description = "Checking saved key",
            Time = 3
        })
    else
        Library:Notify({
            Title = "D2PL",
            Description = "Checking key",
            Time = 3
        })
    end

    task.spawn(function()
        local Source, Error = FetchScript(Key)

        if not Source then
            CheckingKey = false

            if FromStartup then
                DeleteSavedKey()

                Library:Notify({
                    Title = "D2PL",
                    Description = "Saved key is invalid",
                    Time = 5
                })
            else
                Library:Notify({
                    Title = "D2PL",
                    Description = Error,
                    Time = 5
                })
            end

            return
        end

        local Function, CompileError = loadstring(Source)

        if not Function then
            CheckingKey = false

            Library:Notify({
                Title = "D2PL",
                Description = "Failed to compile returned script",
                Time = 5
            })

            warn(CompileError)

            return
        end

        SaveKey(Key)

        CheckingKey = false

        Library:Notify({
            Title = "D2PL",
            Description = "Key accepted",
            Time = 3
        })

        Library:Unload()

        task.wait()

        local Success, RuntimeError = pcall(function()
            Function(Key)
        end)

        if not Success then
            warn(RuntimeError)
        end
    end)
end

